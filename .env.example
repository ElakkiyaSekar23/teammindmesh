# ==============================================================================
# DeepTier Deployment Environment Variables
# ==============================================================================

# PORT: The port the server listens on (default: 3000, injected by Render/Cloud Run/Railway)
PORT=3000

# NODE_ENV: Set to 'production' in production deployments
NODE_ENV=production

# GROQ_API_KEY: Required for Groq AI API calls (llama-3.3-70b-versatile).
# Get your free API key at https://console.groq.com/keys
# Note: DeepTier includes an offline rule engine fallback if this is omitted.
GROQ_API_KEY=""

# APP_URL: Public base URL of the deployed application (e.g. https://my-deeptier.vercel.app)
APP_URL=""
